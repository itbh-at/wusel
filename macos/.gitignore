# Generated by XcodeGen from project.yml — never committed (project.yml is the
# source of truth). The Info.plist and entitlements are generated too, from the
# `info`/`entitlements` properties in project.yml.
Wusel.xcodeproj/
**/Info.plist
**/*.entitlements

# Xcode build output and user state.
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Each contributor's own signing identity / Team ID — MUST NOT enter the repo.
# Copy Config/Local.xcconfig.example to Config/Local.xcconfig and fill it in.
Config/Local.xcconfig

# Bundled engine binary (built by `mise run bundle-wusel`).
Resources/wusel
