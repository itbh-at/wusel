# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 IT Beratung Hermann GmbH
#
# Source for the architecture overview diagram. Render to a committed SVG with:
#   mise run docs-diagrams
# The docs build itself embeds the pre-rendered SVG — it needs no d2 or server.
#
# Palette: soft pastels with light-grey strokes (see the per-shape style blocks).

direction: down

fm: "File manager  (Linux)\nNautilus extension: emblems · \"Wusel\" context menu\nsidebar entry via libcloudproviders" {
  shape: rectangle
  style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
}

finder: "Finder  (macOS, experimental)\nFile Provider extension" {
  shape: rectangle
  style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
}

daemon: "wusel daemon  (wusel mount · wusel serve)" {
  style: {fill: "#FBFBFD"; stroke: "#C6CBD6"}

  fuse: "FUSE frontend\n(wusel-fuse, Linux)" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }
  ipc: "Socket frontend\n(wusel-ipc)" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }
  desktop: "Desktop integration\n(wusel-desktop, Linux)\nnotifications · D-Bus" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }
  fsm: "Decider\n(wusel-fsm)\nno I/O" {
    style: {fill: "#E9F6EE"; stroke: "#B7CBBE"}
  }
  core: "wusel-core" {
    style: {fill: "#F4F5F9"; stroke: "#C6CBD6"}

    runtime: "Substrate\nDB readers · writer · net · file pools" {
      style: {fill: "#E9F6EE"; stroke: "#B7CBBE"}
    }
    client: "Nextcloud client\nWebDAV · OCS · notify_push (WS)" {
      style: {fill: "#F0EBFA"; stroke: "#C4B9D8"}
    }
    db: "Metadata DB (SQLite)\ninode↔path · etag" {
      style: {fill: "#FBF3E3"; stroke: "#D8CBA9"}
    }
    cache: "Blob cache\n(content)" {
      style: {fill: "#FBEAF0"; stroke: "#D8B6C4"}
    }
  }
  fuse -> fsm: "intents"
  ipc -> fsm: "intents"
  fsm <-> core.runtime: "jobs · completions"
  core.runtime -> core.db
  core.runtime -> core.client
  core.client -> core.cache
  core -> desktop: "notices · changes"
}

fm -> daemon.fuse: "file access (kernel)"
fm -> daemon.ipc: "status per file"
daemon.desktop -> fm: "sidebar · FileChanged"
finder -> daemon.ipc: "Unix socket"
