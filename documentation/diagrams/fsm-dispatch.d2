#
# Source for the event-driven dispatch architecture (see pages/concurrency.adoc).
#
# Render to a committed SVG with:  mise run docs-diagrams
#
# The one rule the picture exists to make obvious: the FSM thread decides and
# nothing else. Every box it points at is somewhere work may block; the FSM
# itself never waits for disk, database or network.
#
# Palette matches arch-overview.d2.

direction: down

kernel: "Linux kernel — FUSE\nrequests carry a unique id, replies may come back out of order" {
  shape: rectangle
  style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
}

daemon: "wusel daemon" {
  style: {fill: "#FBFBFD"; stroke: "#C6CBD6"}

  dispatch: "Dispatch threads  (fuser, Config::n_threads)\ntranslate callback → intent · keep the reply object · return at once" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }

  fsm: "FSM thread — decides, never waits\n\nper object a clipboard:  Idle  |  Busy { flow, FIFO queue }\n(an opaque identity — the inode under FUSE, a file id or\nan opaque string on the platforms that may follow)\ncollision(running, arriving) → Queue | Join | Abort | Skip\nadvance(flow, completion) → next step\n\nno disk · no database · no network" {
    style: {fill: "#E9F6EE"; stroke: "#B7CBBE"}
  }

  pump: "Reply pump  (wusel-fuse-replies)\ncompletes the reply objects — the only thread that answers the kernel" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }

  db: "DB threads  (each owns its own connection)" {
    style: {fill: "#FBF3E3"; stroke: "#D8CBA9"}

    writer: "1 writer\nserialises the machine's writes" {
      style: {fill: "#FBF3E3"; stroke: "#D8CBA9"}
    }
    readers: "N readers\nWAL: metadata reads never queue behind a write" {
      style: {fill: "#FBF3E3"; stroke: "#D8CBA9"}
    }
  }

  workers: "I/O workers  (here it may block — that is their job)" {
    style: {fill: "#F0EBFA"; stroke: "#C4B9D8"}

    net: "Network\nWebDAV · OCS\ntwo tiers: waited-for work first,\nbackground re-lists after" {
      style: {fill: "#F0EBFA"; stroke: "#C4B9D8"}
    }
    file: "File I/O\nscratch · blobs" {
      style: {fill: "#F0EBFA"; stroke: "#C4B9D8"}
    }
  }

  uploader: "Uploader thread\nresumes owed uploads · retries transient failures" {
    style: {fill: "#E9F6EE"; stroke: "#B7CBBE"}
  }

  syncer: "Syncer thread  (wusel-walk)\nETag walk on notify_push, catch-up and poll\nown state connection" {
    style: {fill: "#E9F6EE"; stroke: "#B7CBBE"}
  }

  inval: "Invalidation thread  (wusel-fuse-inval)\nemblem refresh via D-Bus FileChanged\n(kernel cache invalidation disabled)" {
    style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
  }

  dispatch -> fsm: "Request\n(mpsc)"
  fsm -> db.readers: "DbRead job"
  fsm -> db.writer: "DbWrite job"
  fsm -> workers.net: "Net job"
  fsm -> workers.file: "FileIo job"
  db -> fsm: "Completion"
  workers -> fsm: "Completion"
  fsm -> pump: "Answer"
  uploader -> fsm: "ResumeUpload"
  syncer -> inval: "changed entries"
}

storage: "Local storage — never on the network home" {
  style: {fill: "#FBEAF0"; stroke: "#D8B6C4"}

  sqlite: "state.sqlite (WAL)\npure cache · relocatable\nSQLite: WAL does not work over NFS/CIFS" {
    style: {fill: "#FBEAF0"; stroke: "#D8B6C4"}
  }
  blobs: "Blob cache + scratch" {
    style: {fill: "#FBEAF0"; stroke: "#D8B6C4"}
  }
}

config: "The user's home  (may be NFS/CIFS)\nconfig.toml · credentials.json · pins.json\nsmall, rarely read — user intent lives here, not in the DB" {
  shape: rectangle
  style: {fill: "#F4F5F9"; stroke: "#C6CBD6"}
}

server: "Nextcloud" {
  shape: rectangle
  style: {fill: "#EAF1FB"; stroke: "#B7BECC"}
}

kernel -> daemon.dispatch: "read/write/lookup/…"
daemon.pump -> kernel: "reply — never from the FSM thread"
daemon.db -> storage.sqlite
daemon.syncer -> storage.sqlite: "reconcile\n(busy timeout)"
daemon.workers.file -> storage.blobs
daemon.workers.net -> storage.blobs: "streamed hydration"
daemon.workers.net -> server
daemon.syncer -> server
daemon -> config: "read at start ·\npins.json re-read when it changes"
